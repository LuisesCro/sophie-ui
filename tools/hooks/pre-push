#!/bin/sh
# ============================================================
# Pre-push · guardas de la suite Sophie
# Crezcamos Online
#
# Corre las guardas ANTES de cada push. Si detectan drift real
# (umbral de metodología, contrato del router o prompt del
# cockpit desincronizado), aborta el push con un mensaje claro.
#
# DOS MODOS, elegidos solos:
#
#  · Push normal → lenient. Los repos de módulos que no tengas
#    montados se OMITEN y no bloquean. El reporte lo dice:
#    cierra en "PARCIAL", nunca en un "OK" que no comprobó.
#
#  · Push que TOCA UNA FUENTE DE UMBRALES → --strict. Si estás
#    moviendo un número canónico, omitir la mitad de las copias
#    en prosa es exactamente el error que estas guardas existen
#    para atrapar. Ahí sí exigimos los repos hermanos montados.
#    Si te bloquea: clona los repos al lado de este, o corre
#    `npm run guardas:strict` para ver qué falta.
#
# Activar en tu clon (una sola vez):
#   git config core.hooksPath tools/hooks
# ============================================================
set -e

DIR="$(git rev-parse --show-toplevel)"
cd "$DIR"

if ! command -v node >/dev/null 2>&1; then
  echo "⚠ node no está disponible; me salto las guardas Sophie."
  exit 0
fi

# ---- ¿este push mueve algún umbral canónico? ----
# Los archivos que son fuente única de números. Si alguno viaja en
# el push, subimos a --strict.
FUENTES="sophie-criterios.js sophie-keywords.js sophie-ppc.js sophie-lanzamiento.js sophie-rescate.js sophie-cotizaciones.js"
ZERO="0000000000000000000000000000000000000000"
MODO=""

# git entrega las refs por stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _lref lsha _rref rsha; do
  [ -z "$lsha" ] && continue
  [ "$lsha" = "$ZERO" ] && continue              # borrado de rama
  if [ "$rsha" = "$ZERO" ] || [ -z "$rsha" ]; then
    BASE="$(git rev-parse --verify --quiet origin/main || true)"   # rama nueva
  else
    BASE="$rsha"
  fi
  [ -z "$BASE" ] && continue
  CAMBIOS="$(git diff --name-only "$BASE" "$lsha" 2>/dev/null || true)"
  for f in $FUENTES; do
    case "$CAMBIOS" in
      *"$f"*) MODO="--strict" ;;
    esac
  done
done

if [ -n "$MODO" ]; then
  echo "▶ Este push mueve una fuente de umbrales → guardas en modo --strict."
else
  echo "▶ Guardas Sophie (pre-push)…"
fi

node tools/guardas.mjs $MODO || {
  echo "✗ Guardas en rojo. Corre 'npm run guardas' para ver cuál. Push abortado."
  exit 1
}

node tools/test-parsers.mjs || {
  echo "✗ Tests de parsers fallando. Corre 'node tools/test-parsers.mjs'. Push abortado."
  exit 1
}

node tools/test-intencion.mjs || {
  echo "✗ Tests de intención (capa 2) fallando. Corre 'node tools/test-intencion.mjs'. Push abortado."
  exit 1
}

node tools/test-cobertura.mjs || {
  echo "✗ Tests de cobertura semántica (Listing) fallando. Corre 'node tools/test-cobertura.mjs'. Push abortado."
  exit 1
}

echo "✓ Guardas + tests OK — push permitido."
